{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["index.ts", "tui.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
