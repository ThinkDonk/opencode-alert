{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode.ai/alert.schema.json",
  "title": "opencode-alert Configuration",
  "description": "Configuration schema for the opencode-alert OpenCode plugin",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Global toggle for the plugin"
    },
    "notifyOnIdle": {
      "type": "boolean",
      "default": true,
      "description": "Whether to send notifications for idle (completion) events"
    },
    "delayMs": {
      "type": "object",
      "description": "Delay in milliseconds before sending notifications per event type. 0 means no delay. Useful when notifications arrive before the TUI finishes rendering results.",
      "properties": {
        "idle": { "type": "number", "minimum": 0 },
        "error": { "type": "number", "minimum": 0 },
        "permission": { "type": "number", "minimum": 0 },
        "question": { "type": "number", "minimum": 0 },
        "cancel": { "type": "number", "minimum": 0 },
        "subagent": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false,
      "default": {
        "idle": 1500,
        "error": 500,
        "permission": 800,
        "question": 800,
        "cancel": 0,
        "subagent": 1000
      }
    },
    "suppressWhenFocused": {
      "type": "boolean",
      "default": true,
      "description": "Suppress notifications when the terminal window is focused"
    },
    "notifyChildSessions": {
      "type": "boolean",
      "default": true,
      "description": "Send notifications for subagent (child session) completion events"
    },
    "soundCommand": {
      "type": "string",
      "default": null,
      "description": "Custom shell command for sound playback. Use {sound} placeholder for the resolved sound file path"
    },
    "desktop": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable desktop notifications"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "idle",
              "error",
              "permission",
              "question",
              "cancel",
              "subagent"
            ]
          },
          "default": ["idle", "error", "permission", "question"],
          "description": "Which event types trigger desktop notifications"
        }
      },
      "additionalProperties": false
    },
    "sound": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable sound notifications"
        },
        "events": {
          "type": "object",
          "properties": {
            "idle": { "type": "string" },
            "error": { "type": "string" },
            "permission": { "type": "string" },
            "question": { "type": "string" },
            "cancel": { "type": "string" },
            "subagent": { "type": "string" }
          },
          "additionalProperties": false,
          "description": "Sound file per event type"
        },
        "default": {
          "type": "string",
          "default": "ding.wav",
          "description": "Default sound file name"
        },
        "customDir": {
          "type": "string",
          "default": "",
          "description": "Directory for custom sound files"
        }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "properties": {
        "quietHours": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "start": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}$",
              "default": "22:00"
            },
            "end": {
              "type": "string",
              "pattern": "^[0-9]{2}:[0-9]{2}$",
              "default": "08:00"
            }
          },
          "additionalProperties": false
        },
        "minInterval": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Minimum seconds between same-type notifications"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
