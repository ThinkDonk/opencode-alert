{
  "name": "@chousyn/opencode-alert",
  "version": "2.0.0",
  "description": "OpenCode v2 TUI notification plugin — desktop and sound alerts for sessions open in each window",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts",
    "./tui": "./tui.ts"
  },
  "files": [
    "index.ts",
    "tui.ts",
    "src",
    "alert.schema.json",
    "sounds",
    "icon.png"
  ],
  "scripts": {
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "notification",
    "alert",
    "desktop-notification",
    "sound"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThinkDonk/opencode-alert.git"
  },
  "homepage": "https://github.com/ThinkDonk/opencode-alert#readme",
  "bugs": {
    "url": "https://github.com/ThinkDonk/opencode-alert/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@biomejs/biome": "^1.9.0"
  }
}
